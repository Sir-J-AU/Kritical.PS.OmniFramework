AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# D365 Sales / Dataverse organisation root, e.g. https://contoso.crm6.dynamics.com
D365_ORG_URL=

# Business Central defaults. Company can also be supplied per tool call.
BC_ENVIRONMENT=Production
BC_COMPANY_ID=

# Safety: all mutating tools refuse execution unless explicitly enabled.
MCP_ENABLE_WRITES=false

# Optional MCP server identity override.
MCP_SERVER_NAME=kritical-microsoft-business
